{
  "manifest_version": 3,
  "name": "Timesheet — Apontamento de horas no Jira",
  "short_name": "Timesheet",
  "version": "1.0.0",
  "description": "Cronometre, organize e envie seus worklogs ao Jira. Tudo fica salvo apenas no seu navegador.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Timesheet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "index.html",
  "commands": {
    "open-app": {
      "suggested_key": { "default": "Alt+J", "mac": "Command+Shift+J" },
      "description": "Abrir o Timesheet"
    }
  },
  "permissions": ["storage", "alarms", "idle", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  }
}
